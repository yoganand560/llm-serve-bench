# Gateway-only image. NOT built or tested on this Mac (Docker is not installed here).
# Metal GPU is unavailable in Docker, so llama-server must run natively on the host.
FROM python:3.13-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

EXPOSE 8000
CMD ["python", "-m", "llm_serve_bench.gateway.app"]
